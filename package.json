{
  "name": "nori-assistant",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "demo": "expo start --clear",
    "server": "node server/index.mjs",
    "server:env": "node --env-file=.env server/index.mjs",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build:ios": "expo export --platform ios --output-dir dist",
    "test:server": "node --test server/index.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~55.0.15",
    "react": "19.2.0",
    "react-native": "0.83.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.3"
  }
}
