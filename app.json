{
  "expo": {
    "name": "Nori",
    "slug": "nori-assistant",
    "scheme": "nori",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0D0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nori.assistant"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D0C"
      },
      "package": "com.nori.assistant"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
